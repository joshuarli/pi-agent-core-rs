{
  "format_version": 1,
  "kind": "declarative_parity_fixture",
  "id": "should-stop-after-tool-turn",
  "description": "A turn policy stops after a completed tool turn instead of requesting a second model response.",
  "setup": {
    "system_prompt": "Use one tool and obey the turn policy.",
    "model": { "provider": "fixture", "id": "deterministic-stop-after-turn" },
    "thinking_level": "off",
    "tools": [
      {
        "name": "echo",
        "description": "Echo text.",
        "parameters": {
          "type": "object",
          "required": ["text"],
          "properties": { "text": { "type": "string" } },
          "additionalProperties": false
        }
      }
    ]
  },
  "actions": [{ "kind": "prompt", "text": "Use echo once." }],
  "model_script": [
    {
      "chunks": [
        { "kind": "tool_call", "id": "call-stop-turn", "name": "echo", "arguments": { "text": "one" } },
        {
          "kind": "done",
          "stop_reason": "tool_call",
          "usage": { "input": 3, "output": 1, "cache_read": 0, "cache_write": 0, "total_tokens": 4 }
        }
      ]
    }
  ],
  "host": {
    "should_stop_after_turn": true,
    "tools": [
      {
        "name": "echo",
        "calls": [
          {
            "arguments": { "text": "one" },
            "result": { "is_error": false, "content": [{ "type": "text", "text": "one" }] }
          }
        ]
      }
    ]
  },
  "assertions": { "outcome": "completed" }
}
