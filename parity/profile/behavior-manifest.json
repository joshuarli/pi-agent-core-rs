{
  "format_version": 1,
  "kind": "pinned_profile_behavior_manifest",
  "upstream": {
    "commit": "9d2ec7ffabe927bfad2214c1cee25b6632a78dcf",
    "package_version": "0.84.1"
  },
  "workspace": {
    "root": "/fixture/workspace",
    "path_inputs_are": "relative-or-absolute-under-root",
    "outside_root": "rejected-before-operation",
    "ambient_authority": [
      "no repository cwd",
      "no HOME",
      "no environment credentials",
      "no .pi resources",
      "no session state",
      "no live provider"
    ]
  },
  "capture_rule": "Each non-grep case runs the pinned factory with only the listed operation adapter, then records the tool result content, error flag, details, and operation calls. Schema rejection is recorded separately from a host-operation failure. Grep is checked by the separate explicit process-seam capture because the pinned factory resolves and spawns rg before consulting GrepOperations.",
  "tools": [
    {
      "name": "read",
      "source": "packages/coding-agent/src/core/tools/read.ts:createReadTool",
      "adapter_methods": ["readFile", "access", "detectImageMimeType"],
      "cases": [
        {"id": "success-text", "kind": "success", "input": {"path": "notes.txt"}, "observes": ["readFile", "text_content"]},
        {"id": "invalid-input", "kind": "invalid_input", "input": {}, "observes": ["schema_error", "no_adapter_call"]},
        {"id": "host-read-failure", "kind": "host_error", "input": {"path": "missing.txt"}, "observes": ["access_error", "error_result"]}
      ]
    },
    {
      "name": "bash",
      "source": "packages/coding-agent/src/core/tools/bash.ts:createBashTool",
      "adapter_methods": ["exec"],
      "cases": [
        {"id": "success-command", "kind": "success", "input": {"command": "printf ok"}, "observes": ["exec_command", "stdout_content", "exit_code"]},
        {"id": "invalid-timeout", "kind": "invalid_input", "input": {"command": "printf ok", "timeout": -1}, "observes": ["timeout_validation_error", "no_exec_call"]},
        {"id": "host-command-failure", "kind": "host_error", "input": {"command": "false"}, "observes": ["exec_command", "nonzero_exit_error_result"]},
        {"id": "host-cancel", "kind": "host_error", "input": {"command": "long-running"}, "observes": ["abort_signal", "exec_command", "error_result"]}
      ]
    },
    {
      "name": "edit",
      "source": "packages/coding-agent/src/core/tools/edit.ts:createEditTool",
      "adapter_methods": ["readFile", "writeFile", "access"],
      "cases": [
        {"id": "success-exact-replacement", "kind": "success", "input": {"path": "src/lib.rs", "edits": [{"oldText": "old", "newText": "new"}]}, "observes": ["readFile", "writeFile", "diff_details", "result_content"]},
        {"id": "invalid-empty-edits", "kind": "invalid_input", "input": {"path": "src/lib.rs", "edits": []}, "observes": ["input_validation_error", "no_write_call"]},
        {"id": "host-write-failure", "kind": "host_error", "input": {"path": "readonly.txt", "edits": [{"oldText": "old", "newText": "new"}]}, "observes": ["access_error", "error_result"]}
      ]
    },
    {
      "name": "write",
      "source": "packages/coding-agent/src/core/tools/write.ts:createWriteTool",
      "adapter_methods": ["writeFile", "mkdir"],
      "cases": [
        {"id": "success-file", "kind": "success", "input": {"path": "out/result.txt", "content": "ok"}, "observes": ["mkdir", "writeFile", "result_content"]},
        {"id": "invalid-missing-content", "kind": "invalid_input", "input": {"path": "out/result.txt"}, "observes": ["schema_error", "no_write_call"]},
        {"id": "host-write-failure", "kind": "host_error", "input": {"path": "readonly/result.txt", "content": "ok"}, "observes": ["writeFile_error", "error_result"]}
      ]
    },
    {
      "name": "grep",
      "source": "packages/coding-agent/src/core/tools/grep.ts:createGrepTool",
      "adapter_methods": ["isDirectory", "readFile"],
      "cases": [
        {"id": "success-match", "kind": "success", "input": {"pattern": "needle", "path": "src"}, "observes": ["search_process", "readFile", "match_content"]},
        {"id": "invalid-missing-pattern", "kind": "invalid_input", "input": {"path": "src"}, "observes": ["schema_error", "no_adapter_call"]},
        {"id": "host-search-failure", "kind": "host_error", "input": {"pattern": "needle", "path": "missing"}, "observes": ["isDirectory_error", "error_result"]}
      ]
    },
    {
      "name": "find",
      "source": "packages/coding-agent/src/core/tools/find.ts:createFindTool",
      "adapter_methods": ["exists", "glob"],
      "cases": [
        {"id": "success-glob", "kind": "success", "input": {"pattern": "**/*.rs", "path": "src"}, "observes": ["exists", "glob", "path_results"]},
        {"id": "invalid-missing-pattern", "kind": "invalid_input", "input": {"path": "src"}, "observes": ["schema_error", "no_adapter_call"]},
        {"id": "host-glob-failure", "kind": "host_error", "input": {"pattern": "**/*.rs", "path": "missing"}, "observes": ["exists_error", "error_result"]}
      ]
    },
    {
      "name": "ls",
      "source": "packages/coding-agent/src/core/tools/ls.ts:createLsTool",
      "adapter_methods": ["exists", "stat", "readdir"],
      "cases": [
        {"id": "success-directory", "kind": "success", "input": {"path": "src"}, "observes": ["exists", "stat", "readdir", "sorted_entries"]},
        {"id": "invalid-limit", "kind": "invalid_input", "input": {"path": "src", "limit": -1}, "observes": ["limit_validation_error", "no_readdir_call"]},
        {"id": "host-directory-failure", "kind": "host_error", "input": {"path": "missing"}, "observes": ["exists_error", "error_result"]}
      ]
    }
  ]
}
