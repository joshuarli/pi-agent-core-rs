{
  "format_version": 1,
  "kind": "quality_core_case",
  "id": "parallel-tool-ordering",
  "description": "One assistant turn emits A, B, and C in source order; named barriers make physical completion C then A then B observable without sleeps.",
  "source": {
    "repository": "https://github.com/earendil-works/pi.git",
    "issue": 2113,
    "issue_url": "https://github.com/earendil-works/pi/issues/2113",
    "upstream_commit_tested": "9d2ec7ffabe927bfad2214c1cee25b6632a78dcf",
    "upstream_package": "@earendil-works/pi-agent-core@0.84.1",
    "role": "scenario_inspiration",
    "historical_behavior_is_oracle": false
  },
  "scope": "core",
  "parity": "strict",
  "oracle": {
    "kind": "current_pinned_upstream_capture",
    "historical_issue_expectation": "not_an_oracle"
  },
  "adapter_fixture": "generated",
  "execution": {
    "deterministic": true,
    "network": false,
    "wall_clock": false,
    "watchdog_ms": 1000
  },
  "setup": {
    "system_prompt": "Run all three tools and report their completion.",
    "model": { "provider": "fixture", "id": "quality-parallel-tool-ordering" },
    "thinking_level": "off",
    "tools": [
      {
        "name": "A",
        "description": "Parallel tool A.",
        "execution_mode": "parallel",
        "parameters": { "type": "object", "additionalProperties": false }
      },
      {
        "name": "B",
        "description": "Parallel tool B.",
        "execution_mode": "parallel",
        "parameters": { "type": "object", "additionalProperties": false }
      },
      {
        "name": "C",
        "description": "Parallel tool C.",
        "execution_mode": "parallel",
        "parameters": { "type": "object", "additionalProperties": false }
      }
    ]
  },
  "actions": [
    { "kind": "prompt", "text": "Run A, B, and C together." }
  ],
  "model_script": [
    {
      "expect_request": { "ordinal": 1, "message_roles": ["system", "user"] },
      "emit": [
        { "type": "tool_call_start", "id": "call-A-001", "name": "A", "arguments": {} },
        { "type": "tool_call_start", "id": "call-B-001", "name": "B", "arguments": {} },
        { "type": "tool_call_start", "id": "call-C-001", "name": "C", "arguments": {} },
        { "type": "done", "stop_reason": "tool_use" }
      ]
    },
    {
      "expect_request": { "ordinal": 2, "message_roles": ["system", "user", "assistant", "tool", "tool", "tool"] },
      "emit": [
        { "type": "text_delta", "text": "all complete" },
        { "type": "done", "stop_reason": "stop" }
      ]
    }
  ],
  "host": {
    "parallel_batch": {
      "source_order": ["A", "B", "C"],
      "start_order_release": ["A", "B", "C"],
      "completion_order_release": ["C", "A", "B"],
      "result_context_order": "capture"
    },
    "tools": [
      {
        "name": "A",
        "calls": [
          {
            "arguments": {},
            "completion_barrier": { "name": "parallel-completion", "release_rank": 2 },
            "result": { "is_error": false, "content": [{ "type": "text", "text": "A complete" }] }
          }
        ]
      },
      {
        "name": "B",
        "calls": [
          {
            "arguments": {},
            "completion_barrier": { "name": "parallel-completion", "release_rank": 3 },
            "result": { "is_error": false, "content": [{ "type": "text", "text": "B complete" }] }
          }
        ]
      },
      {
        "name": "C",
        "calls": [
          {
            "arguments": {},
            "completion_barrier": { "name": "parallel-completion", "release_rank": 1 },
            "result": { "is_error": false, "content": [{ "type": "text", "text": "C complete" }] }
          }
        ]
      }
    ]
  },
  "observations": {
    "measure": [
      "assistant/source order",
      "tool execution start order",
      "physical completion order",
      "tool_execution_end event order",
      "toolResult message emission order",
      "toolResult insertion order in the next model request"
    ],
    "sequences": ["source_order", "start_order", "completion_order", "context_result_order"],
    "metrics": ["parallel_batches", "max_parallel_width", "tool_execution_start_order", "tool_execution_completion_order", "tool_result_context_order"],
    "invariants": ["three_calls_have_three_terminal_results", "run_settled", "no_events_after_agent_end"]
  }
}
