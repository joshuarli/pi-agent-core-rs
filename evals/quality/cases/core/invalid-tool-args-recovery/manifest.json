{
  "format_version": 1,
  "kind": "quality_core_case",
  "id": "invalid-tool-args-recovery",
  "description": "A strict-schema tool call omits a required property, then the scripted model retries with valid arguments.",
  "source": {
    "repository": "https://github.com/earendil-works/pi.git",
    "issue": 5194,
    "issue_url": "https://github.com/earendil-works/pi/issues/5194",
    "role": "scenario_inspiration",
    "historical_behavior_is_oracle": false
  },
  "scope": "core",
  "gate": "strict",
  "contract": {
    "kind": "rust_fixture_runner"
  },
  "adapter_fixture": "generated",
  "execution": {
    "deterministic": true,
    "network": false,
    "wall_clock": false,
    "watchdog_ms": 1000
  },
  "setup": {
    "system_prompt": "Use write_value only with both path and value.",
    "model": { "provider": "fixture", "id": "quality-invalid-tool-args-recovery" },
    "thinking_level": "off",
    "tools": [
      {
        "name": "write_value",
        "description": "Store one deterministic value at a logical path.",
        "parameters": {
          "type": "object",
          "properties": {
            "path": { "type": "string" },
            "value": { "type": "string" }
          },
          "required": ["path", "value"],
          "additionalProperties": false
        }
      }
    ]
  },
  "actions": [
    { "kind": "prompt", "text": "Write one value, correcting any argument error." }
  ],
  "model_script": [
    {
      "expect_request": { "ordinal": 1, "message_roles": ["system", "user"] },
      "emit": [
        {
          "type": "tool_call_start",
          "id": "call-invalid-args-001",
          "name": "write_value",
          "arguments": { "value": "one" }
        },
        { "type": "done", "stop_reason": "tool_use" }
      ]
    },
    {
      "expect_request": { "ordinal": 2, "message_roles": ["system", "user", "assistant", "tool"] },
      "emit": [
        {
          "type": "tool_call_start",
          "id": "call-valid-args-001",
          "name": "write_value",
          "arguments": { "path": "/logical/output", "value": "one" }
        },
        { "type": "done", "stop_reason": "tool_use" }
      ]
    },
    {
      "expect_request": { "ordinal": 3, "message_roles": ["system", "user", "assistant", "tool", "assistant", "tool"] },
      "emit": [
        { "type": "text_delta", "text": "write complete" },
        { "type": "done", "stop_reason": "stop" }
      ]
    }
  ],
  "host": {
    "tools": [
      {
        "name": "write_value",
        "calls": [
          {
            "arguments": { "path": "/logical/output", "value": "one" },
            "result": {
              "is_error": false,
              "content": [{ "type": "text", "text": "stored" }]
            }
          }
        ]
      }
    ]
  },
  "observations": {
    "measure": [
      "whether the missing-path call reaches the executor",
      "validation error class, structure, and isError result semantics",
      "the exact error content presented to the corrective model turn",
      "successful execution of the corrected call and recovery turn count"
    ],
    "metrics": ["model_calls", "tool_validation_errors", "tool_execution_errors", "successful_retries", "turns_to_recovery", "tool_calls_to_recovery"],
    "invariants": ["invalid_call_never_executes", "valid_call_executes_once", "run_settled"]
  }
}
