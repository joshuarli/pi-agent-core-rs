{
  "format_version": 1,
  "kind": "declarative_parity_fixture",
  "id": "awaited-agent-end-observer",
  "description": "A registered listener holds agent_end until the fixture releases it; the run must stay active before release and become idle afterward.",
  "setup": {
    "system_prompt": "Reply once and stop.",
    "model": { "provider": "fixture", "id": "deterministic-observer-settlement" },
    "thinking_level": "off",
    "tools": []
  },
  "actions": [{ "kind": "prompt", "text": "Finish the observer settlement test." }],
  "model_script": [
    {
      "chunks": [
        { "kind": "text_delta", "text": "listener settled" },
        {
          "kind": "done",
          "stop_reason": "stop",
          "usage": { "input": 0, "output": 0, "cache_read": 0, "cache_write": 0, "total_tokens": 0 }
        }
      ]
    }
  ],
  "host": {
    "observer": { "hold_agent_end": true },
    "tools": []
  },
  "assertions": { "outcome": "completed", "assistant_text": "listener settled" }
}
