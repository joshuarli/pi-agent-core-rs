{
  "format_version": 1,
  "kind": "declarative_parity_fixture",
  "id": "before-tool-block-continues",
  "description": "The before-tool policy blocks a valid call, records its stated error result, and permits recovery on the next model turn.",
  "setup": {
    "system_prompt": "Use the echo tool when supplied.",
    "model": {
      "provider": "fixture",
      "id": "deterministic-before-hook"
    },
    "thinking_level": "off",
    "tools": [
      {
        "name": "echo",
        "description": "Return the supplied text.",
        "parameters": {
          "type": "object",
          "required": ["text"],
          "properties": { "text": { "type": "string" } },
          "additionalProperties": false
        }
      }
    ]
  },
  "actions": [{ "kind": "prompt", "text": "Attempt an echo, then recover." }],
  "model_script": [
    {
      "chunks": [
        {
          "kind": "tool_call",
          "id": "call_block_001",
          "name": "echo",
          "arguments": { "text": "hello" }
        },
        {
          "kind": "done",
          "stop_reason": "tool_call",
          "usage": {
            "input": 0,
            "output": 0,
            "cache_read": 0,
            "cache_write": 0,
            "total_tokens": 0
          }
        }
      ]
    },
    {
      "chunks": [
        { "kind": "text_delta", "text": "recovered" },
        {
          "kind": "done",
          "stop_reason": "stop",
          "usage": {
            "input": 0,
            "output": 0,
            "cache_read": 0,
            "cache_write": 0,
            "total_tokens": 0
          }
        }
      ]
    }
  ],
  "host": {
    "before_tool_call": {
      "tool_name": "echo",
      "reason": "fixture policy blocked echo"
    },
    "tools": []
  },
  "assertions": {
    "outcome": "completed",
    "assistant_text": "recovered"
  }
}
