{
  "format_version": 1,
  "kind": "declarative_parity_fixture",
  "id": "tool-continue",
  "description": "A sequential echo tool result becomes the context for a second model turn.",
  "setup": {
    "system_prompt": "Use the echo tool when a tool call is supplied.",
    "model": {
      "provider": "fixture",
      "id": "deterministic-tool"
    },
    "thinking_level": "off",
    "tools": [
      {
        "name": "echo",
        "description": "Return the supplied text.",
        "parameters": {
          "type": "object",
          "required": ["text"],
          "properties": {
            "text": { "type": "string" }
          },
          "additionalProperties": false
        }
      }
    ]
  },
  "actions": [
    {
      "kind": "prompt",
      "text": "Echo hello, then confirm completion."
    }
  ],
  "model_script": [
    {
      "chunks": [
        {
          "kind": "tool_call",
          "id": "call_openrouter_001",
          "name": "echo",
          "arguments": { "text": "hello" }
        },
        {
          "kind": "done",
          "stop_reason": "tool_call",
          "usage": {
            "input": 0,
            "output": 0,
            "cache_read": 0,
            "cache_write": 0,
            "total_tokens": 0
          }
        }
      ]
    },
    {
      "chunks": [
        {
          "kind": "text_delta",
          "text": "done"
        },
        {
          "kind": "done",
          "stop_reason": "stop",
          "usage": {
            "input": 0,
            "output": 0,
            "cache_read": 0,
            "cache_write": 0,
            "total_tokens": 0
          }
        }
      ]
    }
  ],
  "host": {
    "tools": [
      {
        "name": "echo",
        "calls": [
          {
            "arguments": { "text": "hello" },
            "result": {
              "is_error": false,
              "content": [
                { "type": "text", "text": "echoed: hello" }
              ]
            }
          }
        ]
      }
    ]
  },
  "assertions": {
    "outcome": "completed",
    "event_types": [
      "agent_start",
      "turn_start",
      "message_start:user",
      "message_end:user",
      "message_start:assistant",
      "message_end:assistant",
      "tool_execution_start",
      "tool_execution_end",
      "message_start:tool_result",
      "message_end:tool_result",
      "turn_end",
      "turn_start",
      "message_start:assistant",
      "message_update:assistant",
      "message_end:assistant",
      "turn_end",
      "agent_end",
      "agent_settled"
    ],
    "assistant_text": "done"
  }
}
