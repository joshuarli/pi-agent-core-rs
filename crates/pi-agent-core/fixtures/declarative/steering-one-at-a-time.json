{
  "format_version": 1,
  "kind": "declarative_parity_fixture",
  "id": "steering-one-at-a-time",
  "description": "Queued steering drains once before the initial model request and once after the first assistant turn.",
  "setup": {
    "system_prompt": "Respond to each turn deterministically.",
    "model": {
      "provider": "fixture",
      "id": "deterministic-steering"
    },
    "thinking_level": "off",
    "tools": []
  },
  "actions": [
    { "kind": "steer", "text": "first steering" },
    { "kind": "steer", "text": "second steering" },
    { "kind": "prompt", "text": "initial prompt" }
  ],
  "model_script": [
    {
      "chunks": [
        { "kind": "text_delta", "text": "first response" },
        {
          "kind": "done",
          "stop_reason": "stop",
          "usage": {
            "input": 0,
            "output": 0,
            "cache_read": 0,
            "cache_write": 0,
            "total_tokens": 0
          }
        }
      ]
    },
    {
      "chunks": [
        { "kind": "text_delta", "text": "second response" },
        {
          "kind": "done",
          "stop_reason": "stop",
          "usage": {
            "input": 0,
            "output": 0,
            "cache_read": 0,
            "cache_write": 0,
            "total_tokens": 0
          }
        }
      ]
    }
  ],
  "host": { "tools": [] },
  "assertions": {
    "outcome": "completed",
    "assistant_text": "second response"
  }
}
